{
  "name": "@nyx/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A personal desktop AI chat tool.",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package:mac:dev": "../../scripts/prepare-package-runtime.sh && pnpm build && env NYX_PACKAGE_FLAVOR=dev electron-builder --config electron-builder.config.mjs --mac dmg zip --arm64 --publish never",
    "package:mac:prod": "../../scripts/prepare-package-runtime.sh && pnpm build && env NYX_PACKAGE_FLAVOR=prod electron-builder --config electron-builder.config.mjs --mac dmg zip --arm64 --publish never",
    "package:mac:verify": "../../scripts/check-mac-package.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsgo --noEmit -p tsconfig.app.json && tsgo --noEmit -p tsconfig.node.json",
    "typecheck:compat": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.17.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript/native-preview": "^7.0.0-dev.20260612.1",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^41.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.69.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
